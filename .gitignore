*.DS_Store
.DS_Store

# Secrets — commit only the .example / .template counterparts
.env
.env.local
# Per-developer Claude Code settings: records local tool permissions and has
# held connection strings.
.claude/settings.local.json
*.tfvars
!*.tfvars.example

# Local artifacts
*.bak
*.log
**/test-results/
**/backup-*/
**/backup-metadata-*/
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Terraform working state. A saved plan carries the whole state inside it, so
# ignoring *.tfstate alone is not enough — that is how a tfplan holding real
# account IDs, bucket names and role ARNs got committed to clickhouse-hols once.
**/.terraform/
*.tfstate
*.tfstate.*
tfplan
*.tfplan
# Editor leftovers next to a tfvars file: terraform.tfvars.save is not matched
# by *.tfvars.
*.tfvars.*
!*.tfvars.example

# usage-cost lab: raw API responses and flattened records (real names, IDs and amounts live there)
labs/billing/*/out/

# aurora-analytics lab: preflight output and the generated config (holds passwords). The destroyed-*
# copy deploy/destroy leave behind holds them too.
labs/postgres/*/out/
labs/postgres/*/config.env
labs/postgres/*/config.env.destroyed-*
# aurora-analytics lab: generated data and the fetched query set (work/), also for the local rehearsal
# (out/rehearsal/ and work/rehearsal/ are covered by the two rules above and this one)
labs/postgres/*/work/
labs/postgres/*/*.duckdb
labs/postgres/*/**/*.parquet
