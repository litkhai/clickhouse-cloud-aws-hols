# Copy to .env (gitignored, mode 600). Never commit the filled-in file.
# ClickHouse Cloud service (CH_HOST / CH_USER / CH_PASSWORD), for clickhouse client --secure
CH_HOST=
CH_USER=default
CH_PASSWORD=
# The service's IAM role: console -> service Settings -> Network security information
CHC_IAM_ROLE_ARN=
# ClickHouse Cloud OpenAPI key (05-cost.py, Usage Cost API)
CHC_KEY=
CHC_SECRET=
CHC_ORG_ID=
CHC_SERVICE_ID=
AWS_REGION=ap-northeast-2
