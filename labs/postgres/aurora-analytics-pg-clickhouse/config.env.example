# Written by deploy.sh (mode 600, gitignored): copy of the Terraform outputs. One KEY=value per line.
AWS_REGION=
BUCKET=
S3_PREFIX=tpcds
AURORA_CLUSTER_ID=
AURORA_INSTANCE_ID=
AURORA_CLASS=
AURORA_HOST=
AURORA_PORT=5432
AURORA_USER=postgres
AURORA_DB=postgres
AURORA_SECRET_ARN=
PGFRONT_HOST=
PGFRONT_PORT=5432
PGFRONT_USER=postgres
PGFRONT_PASSWORD=
PGFRONT_DB=postgres
# require for a ClickHouse Managed Postgres service (the plan); disable for the Terraform EC2 front end (create_pgfront = true)
PGFRONT_SSLMODE=require
PGFRONT_INSTANCE_ID=
PGFRONT_PUBLIC_IP=
GENERATOR_PUBLIC_IP=
CHC_S3_ROLE_ARN=
# empty unless enable_glue = true (the Glue catalog + Iceberg variant, README)
GLUE_PARQUET_DB=
GLUE_ICEBERG_DB=
ATHENA_WORKGROUP=
GLUE_CATALOG_ARN=
# filled by hand after creating the ClickHouse Cloud service
CH_HOST=
CH_USER=default
CH_PASSWORD=
CH_SERVICE_ID=
CH_REPLICA_MEMORY_GB=8
CH_REPLICAS=
