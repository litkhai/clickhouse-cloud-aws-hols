# Copy to terraform.tfvars (gitignored) and fill in the required values.
# Required: owner, ttl, allowed_cidr_blocks.

aws_region = "ap-northeast-2"

owner = "your-name"
ttl   = "2026-10-31" # date after which this lab should be gone

# Your own address. 0.0.0.0/0 is rejected. e.g. ["203.0.113.4/32"]
allowed_cidr_blocks = ["203.0.113.4/32"]

# Existing EC2 key pair in aws_region for SSH. Leave out to use SSM Session Manager only.
# key_name = "your-key-pair"

# Aurora engine and the front end must share a major version (17.11+ or 18.6+ for aurora_analytics)
aurora_engine_version = "17.11"
pg_major              = "17"

# One cluster, one instance; the class is what changes between test targets.
# deploy.sh --class <c> overrides it for one run without editing this file.
#   db.t4g.medium  - smallest burstable target
#   db.t4g.large   - default
#   db.serverless  - Serverless v2, scales between serverless_min_acu and serverless_max_acu
#   db.r8g.large   - memory-optimised Graviton
#   db.r8gd.xlarge - Graviton with local NVMe, the smallest d-class orderable for 17.11 / 18.6
#                    in ap-northeast-2 (db.r8gd.large: 0 orderable options, read 2026-10-09)
aurora_instance_class = "db.t4g.large"

# "" = Aurora Standard, "aurora-iopt1" = Aurora I/O-Optimized
# aurora_storage_type = ""

# Used only for db.serverless
# serverless_min_acu = 0.5
# serverless_max_acu = 8

# Extra cluster parameters for the later tuned run (applied at the next reboot)
# extra_cluster_parameters = {
#   "work_mem" = "65536"
# }

# Instance sizes
# generator_instance_type = "m7g.4xlarge"
# generator_disk_gb       = 500
# pgfront_instance_type   = "t4g.large"   # or t4g.medium

# Set to false to leave a part out
# create_aurora    = true
# create_generator = true
# create_pgfront   = false   # true = self-managed EC2 front end instead of Managed Postgres

# IAM role of the ClickHouse Cloud service (console: service settings, Network security
# information). Empty = no role for ClickHouse Cloud is created; fill it in and apply again later.
# chc_iam_role_arn = ""

# Optional Iceberg variant: Glue databases, Glue interface endpoint, Athena workgroup, IAM (README,
# "Glue catalog and Iceberg"). Adds resources and edits IAM policy documents in place; nothing is replaced.
# enable_glue = true
