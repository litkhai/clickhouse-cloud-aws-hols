# Copy to .env next to the scripts and chmod 600. .env is gitignored: never commit it.
# A variable set in the process environment wins over .env.

# Organization API key (Console -> Organization -> API Keys).
#   01-fetch.py needs control-plane:organization:view   (system role Member is enough)
#   04-backups.py also needs control-plane:service:view-backups (system role Basic Service Reader)
CHC_ORG_ID=<organization-id>
CHC_API_KEY_ID=<api-key-id>
CHC_API_KEY_SECRET=<api-key-secret>

# Service for 02-load.sql and 03-allocate.sql (clickhouse client, native TLS).
# The Python scripts do not read these. Export them with `set -a; . ./.env; set +a`:
# clickhouse client reads CLICKHOUSE_PASSWORD from the environment.
CH_HOST=<service-host>
CH_USER=<sql-user>
CLICKHOUSE_PASSWORD=<sql-password>
