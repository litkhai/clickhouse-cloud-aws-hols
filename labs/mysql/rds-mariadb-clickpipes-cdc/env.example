# Copy to .env (git-ignored) and fill in. Every script sources ./.env.
AWS_REGION=ap-northeast-2
# ClickHouse Cloud OpenAPI key with ClickPipes manage rights, the organization and the target service
CHC_KEY=
CHC_SECRET=
ORG_ID=
SERVICE_ID=
# The ClickPipes regions whose egress IPs may reach the source (see the pipe's Details tab: "Region").
# A service created before 2025-11-15 in ap-northeast-2 used us-east-2 in our run; a new one used ap-northeast-2.
CLICKPIPES_REGIONS="ap-northeast-2 us-east-2"
# RDS names; 01-rds.sh writes MASTER_PW, CP_PW and RDS_HOST to out/rds.env
DB_ID=cp-mariadb-cdc-lab
ENGINE=mariadb
ENGINE_VERSION=11.8.9
PG_FAMILY=mariadb11.8
